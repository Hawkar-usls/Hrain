{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A15 Janus Temple Graph",
  "type": "object",
  "required": ["meta", "nodes", "links"],
  "properties": {
    "meta": { "type": "object" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "type": "string" },
          "group": { "type": "string" },
          "z": { "type": ["number", "integer", "null"] },
          "score": { "type": ["number", "integer", "null"] },
          "source": { "type": ["string", "null"] },
          "data": { "type": "object" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "kind": { "type": "string" },
          "weight": { "type": ["number", "integer"] },
          "data": { "type": "object" }
        }
      }
    }
  }
}
